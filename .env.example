# Variáveis de ambiente do Escritório do Especialista.
# Copie para .env só no seu computador. No Render, cadastre em Environment.
# Senhas, tokens e chaves nunca ficam aqui: só os nomes.
# Passo a passo em docs/PASSO_A_PASSO_ETAPA1.md.

# ---- Etapa 1 (obrigatórias no Render) ----
# Endereço do banco Postgres do Supabase, colado como vem (Connect > Direct > Session pooler), com o [YOUR-PASSWORD]
DATABASE_URL=
# Senha do banco do Supabase (entra sozinha no lugar do [YOUR-PASSWORD])
DATABASE_PASSWORD=
# Segredo da sessão (o Render gera sozinho com "Generate"; mínimo de 32 caracteres)
SESSION_SECRET=
# Cliente OAuth do Google Cloud ("Entrar com Google")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# E-mails Google que são sempre administradores, separados por vírgula
ADMIN_EMAILS=exoduscomercialcb@gmail.com
TZ=America/Sao_Paulo

# ---- Etapa 1 (opcionais) ----
# Outros endereços que abrem o escritório, separados por vírgula (o padrão já é escritorio.exodusbeneficios.com.br;
# o endereço .onrender.com entra sozinho)
HOSTS_ESCRITORIO=
# 1 = a coordenação também abre o painel do administrador
PAINEL_COORDENACAO=
# Só no computador, para testes: 1 liga a rota de login sem Google. No Render ela nunca liga.
MODO_TESTE=

# ---- Etapa 2: busca automática (SGA, Power CRM) ----
# Do arquivo SGA-REMARKETING.txt do Kit privado: "TOKEN SGA", "usuario=" e "senha="
SGA_TOKEN=
SGA_USUARIO=
SGA_SENHA=
# Do arquivo POWERCRM.txt do Kit privado
POWERCRM_TOKEN=
# A busca completa roda sozinha todo dia às 06:00 e às 16:00, no Render. 0 desliga (fica só o botão do painel).
BUSCA_AUTOMATICA=

# ---- Próximas etapas (ainda não usadas pelo código) ----
GOOGLE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
APPS_SCRIPT_URL=
